<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="Canopy2">
    <static>true</static>
    <link name="link">
      
      <collision name="base_collision">
        <pose>0 0 2 0 0 0</pose>
        <geometry>
          <box>
            <size>4 4 4</size>
          </box>
        </geometry>
      </collision>

      <collision name="roof_collision">
        <pose>0 0 4.0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>2</radius>
          </sphere>
        </geometry>
      </collision>
      
      <visual name="visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>meshes/canopy2.dae</uri>
          </mesh>
        </geometry>
      </visual>

    </link>
  </model>
</sdf>