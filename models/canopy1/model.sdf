<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="Canopy1">
    <static>true</static>
    <link name="link">
      
      <collision name="base_collision">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry>
          <box>
            <size>3 3 3</size>
          </box>
        </geometry>
      </collision>

      <collision name="roof_collision">
        <pose>0 0 3.0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>1.5</radius>
          </sphere>
        </geometry>
      </collision>
      
      <visual name="visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>meshes/canopy1.dae</uri>
          </mesh>
        </geometry>
      </visual>

    </link>
  </model>
</sdf>